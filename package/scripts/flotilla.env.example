# Copy to scripts/flotilla.env and adjust. Loaded by run_with_secrets.sh.
# Never put secret VALUES here: tokens come from your vault (Infisical).

# Workspace root (defaults to the folder above scripts/)
# FLOTILLA_WORKSPACE=/path/to/my-fleet

# Infisical project that holds TELEGRAM_TOKEN, agent API keys, etc.
# FLOTILLA_INFISICAL_PROJECT_ID=
# INFISICAL_ENV=dev
# INFISICAL_API_URL=https://eu.infisical.com/api   # EU-hosted projects only

# Telegram chat of the human manager (not secret, but personal)
# TELEGRAM_CHAT_ID=

# How agents address the human approver in prompts and briefs
# FLOTILLA_HUMAN_NAME=Alex

# PRIVATE GitHub repo that mirrors the task board as issues (empty = off)
# FLOTILLA_GITHUB_REPO=your-org/your-private-workspace

# Extra repos whose new commits count as agent work evidence (colon-separated)
# FLOTILLA_TRACKED_REPOS=/path/to/app-one:/path/to/app-two

# Cloud dashboard snapshot endpoint for fleet_push.py (optional)
# FLEET_SYNC_URL=https://your-server/fleet/snapshot
